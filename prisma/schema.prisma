// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderType {
  BUY
  SELL
}

enum BalanceState {
  OPEN
  CLOSED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUBSCRIBER
  USER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum AccountTransactionType {
  DEPOSIT
  WITHDRAWAL
}

model Company {
  idAuto             Int                  @id @default(autoincrement())
  id                 String               @unique
  name               String               @unique
  address            String?
  phone              String?
  email              String?
  orders             Order[]
  customers          Customer[]
  users              User[]
  prices             Price[]
  accountsTypes      AccountType[]
  currencies         Currency[]
  accounts           Account[]
  AccountTransaction AccountTransaction[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now()) @updatedAt
}

model Customer {
  idAuto    Int      @id @default(autoincrement())
  id        String   @unique
  email     String?
  name      String
  lastName  String
  phone     String?
  address   String?
  orders    Order[]
  company   Company  @relation(fields: [companyId], references: [idAuto])
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Order {
  idAuto     Int       @id @default(autoincrement())
  id         String    @unique
  type       OrderType
  price      Float
  usdAmount  Float
  pesoAmount Float
  user       User      @relation(fields: [userId], references: [idAuto])
  userId     Int
  customer   Customer  @relation(fields: [customerId], references: [idAuto])
  customerId Int
  balance    Balance   @relation(fields: [balanceId], references: [idAuto])
  balanceId  Int
  company    Company   @relation(fields: [companyId], references: [idAuto])
  companyId  Int
  userExec   User?     @relation("UserExec", fields: [userExecId], references: [idAuto]) // user that execute the order
  userExecId Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Balance {
  idAuto             Int          @id @default(autoincrement())
  id                 String       @unique
  usdInitialAmount   Float
  pesosInitialAmount Float
  usdAmount          Float
  pesosAmount        Float
  state              BalanceState
  orders             Order[]
  user               User         @relation(fields: [userId], references: [idAuto])
  userId             Int
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Price {
  idAuto       String   @id @default(cuid())
  id           String   @unique
  currency     String
  priceBuy     Float
  priceSell    Float
  sourceOrigin String?
  company      Company  @relation(fields: [companyId], references: [idAuto])
  companyId    Int
  createdAt    DateTime @default(now())
}

model Config {
  idAuto             Int      @id @default(autoincrement())
  id                 String   @unique
  priceSourceOrigin  String?
  priceTimeToRefresh Int?     @default(60) // in minutes
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model User {
  idAuto     Int       @id @default(autoincrement())
  id         String    @unique
  email      String?
  name       String
  lastName   String
  profile    Profile?
  balances   Balance[]
  orders     Order[]
  ordersExec Order[]   @relation("UserExec")
  company    Company   @relation(fields: [companyId], references: [idAuto])
  account    Account[]
  companyId  Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Profile {
  idAuto       Int           @id @default(autoincrement())
  id           String        @unique
  role         Role          @default(USER)
  user         User          @relation(fields: [userId], references: [idAuto])
  userId       Int           @unique
  loginName    String        @unique
  active       Boolean       @default(false)
  activeTokens ActiveToken[]
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ActiveToken {
  idAuto      Int       @id @default(autoincrement())
  id          String    @unique
  token       String    @unique
  activatedAt DateTime?
  profile     Profile   @relation(fields: [profileId], references: [idAuto])
  profileId   Int       @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Account {
  idAuto        Int                  @id @default(autoincrement())
  id            String               @unique
  user          User                 @relation(fields: [userId], references: [idAuto])
  userId        Int
  company       Company              @relation(fields: [companyId], references: [idAuto])
  companyId     Int
  balance       Float
  type          AccountType          @relation(fields: [accountTypeId], references: [idAuto])
  accountTypeId Int
  currency      Currency             @relation(fields: [currencyId], references: [idAuto])
  currencyId    Int
  transactions  AccountTransaction[]
  status        AccountStatus        @default(ACTIVE)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model AccountType {
  idAuto    Int       @id @default(autoincrement())
  id        String    @unique
  name      String
  accounts  Account[]
  comapny   Company   @relation(fields: [companyId], references: [idAuto])
  companyId Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Currency {
  idAuto             Int                  @id @default(autoincrement())
  id                 String               @unique
  name               String
  symbol             String
  flag               String?
  comapny            Company              @relation(fields: [companyId], references: [idAuto])
  companyId          Int
  AccountTransaction AccountTransaction[]
  accounts           Account[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model AccountTransaction {
  idAuto     Int                    @id @default(autoincrement())
  id         String                 @unique
  account    Account                @relation(fields: [accountId], references: [idAuto])
  accountId  Int
  company    Company                @relation(fields: [companyId], references: [idAuto])
  companyId  Int
  amount     Float
  currency   Currency               @relation(fields: [currencyId], references: [idAuto])
  currencyId Int
  type       AccountTransactionType
  detail     String?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
}
